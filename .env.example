# Copy to .env and adjust. All values here are for local development only.

# --- Postgres ---
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Directory containing the raw Olist CSVs (inside the backend container)
OLIST_DATA_DIR=/data/olist
# Password for the seeded dev accounts (admin / staff / customer)
DEV_USER_PASSWORD=devpass123

# --- Frontend ---
# Base URL the Next.js server uses to reach the API (server-side only)
API_URL=http://backend:8000

# --- Host ports (change if they clash with other local services) ---
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
# Public URL of the Django admin, used by the "Admin" nav link
NEXT_PUBLIC_ADMIN_URL=http://localhost:8000/admin/

# --- Auth / orders ---
# Browser origins allowed to send unsafe requests through the Next.js proxy (CSRF Origin check).
# Must match http://localhost:<FRONTEND_HOST_PORT>; frontend:3000 is the e2e browser.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://frontend:3000
# How long checkout holds stock for an unpaid order
RESERVATION_TTL_MINUTES=15
# Simulated payment endpoint (dev only; never enable in production)
ALLOW_FAKE_PAYMENTS=true

# --- Events ---
# Shared secret for POST /internal/revalidate (Django consumers -> Next.js cache invalidation)
REVALIDATE_SECRET=dev-revalidate-change-me
# How the backend containers reach the Next.js server
FRONTEND_INTERNAL_URL=http://frontend:3000
